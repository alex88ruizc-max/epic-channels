<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#06090f">
<title>Códigos · privado</title>
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="referrer" content="no-referrer">
<style>
  :root { --bg:#06090f; --vidrio:rgba(255,255,255,.06); --borde:rgba(255,255,255,.12); --texto:#eef2f7; --suave:#98a2b3; --verde:#34d399; --verde2:#10b981; --ambar:#fbbf24; --rojo:#fb7185; }
  * { box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
  html, body { min-height:100%; }
  body { font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; background:var(--bg); color:var(--texto); -webkit-text-size-adjust:100%; overflow-x:hidden;
    padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom); }
  .fondo { position:fixed; inset:0; z-index:0; overflow:hidden; pointer-events:none; }
  .fondo i { position:absolute; border-radius:50%; filter:blur(70px); opacity:.55; animation:flota 14s ease-in-out infinite alternate; }
  .fondo i:nth-child(1){ width:340px; height:340px; background:#059669; top:-90px; left:-80px; }
  .fondo i:nth-child(2){ width:300px; height:300px; background:#0ea5e9; bottom:-80px; right:-70px; animation-delay:-5s; opacity:.4; }
  .fondo i:nth-child(3){ width:220px; height:220px; background:#7c3aed; top:45%; left:55%; animation-delay:-9s; opacity:.3; }
  @keyframes flota { to { transform:translate(30px,40px) scale(1.12); } }
  main { position:relative; z-index:1; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:28px 18px; }
  .caja { width:100%; max-width:420px; background:var(--vidrio); border:1px solid var(--borde); border-radius:28px; padding:28px 22px;
    backdrop-filter:blur(22px) saturate(140%); -webkit-backdrop-filter:blur(22px) saturate(140%); box-shadow:0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.08); }
  .icono { width:62px; height:62px; margin:0 auto; border-radius:20px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,rgba(52,211,153,.25),rgba(14,165,233,.18)); border:1px solid rgba(52,211,153,.35); }
  .icono svg { width:30px; height:30px; }
  h1 { text-align:center; font-size:23px; font-weight:800; margin-top:14px; letter-spacing:-.2px; }
  .sub { text-align:center; font-size:14px; color:var(--suave); margin-top:6px; line-height:1.45; }
  label { display:block; font-size:12px; color:var(--suave); margin:22px 0 7px 4px; font-weight:600; }
  input { width:100%; font-size:16px; padding:15px 16px; border-radius:16px; border:1px solid var(--borde); background:rgba(0,0,0,.28); color:var(--texto); outline:none; transition:border .2s; }
  input:focus { border-color:rgba(52,211,153,.7); box-shadow:0 0 0 4px rgba(52,211,153,.12); }
  button { font:inherit; cursor:pointer; border:none; }
  .btn { width:100%; margin-top:12px; padding:15px; border-radius:16px; font-size:16px; font-weight:800; color:#04110b;
    background:linear-gradient(135deg,var(--verde),var(--verde2)); box-shadow:0 10px 30px rgba(16,185,129,.35); transition:transform .1s, opacity .2s; }
  .btn:active { transform:scale(.98); }
  .btn:disabled { opacity:.6; }
  .tip { font-size:12px; color:var(--suave); text-align:center; margin-top:12px; line-height:1.45; }
  .res { margin-top:20px; }
